#!/bin/sh
# themisto-uninstall — removes all Themisto components from this Mac.
set -eu

PLIST="/Library/LaunchDaemons/com.themisto.agent.plist"
LABEL="com.themisto.agent"

if [ "$(id -u)" -ne 0 ]; then
  echo "error: run as root (use sudo)" >&2
  exit 1
fi

echo "Uninstalling Themisto..."

# ── Stop and remove the launchd daemon ──────────────────────────────────────

if /bin/launchctl print "system/$LABEL" >/dev/null 2>&1; then
  echo "  Stopping agent service..."
  /bin/launchctl bootout "system/$LABEL" >/dev/null 2>&1 || true
  sleep 1
fi

# ── Clear system proxy settings ─────────────────────────────────────────────

if [ -x "/usr/local/bin/themisto-agent" ]; then
  echo "  Clearing system proxy settings..."
  /usr/local/bin/themisto-agent -proxy-off >/dev/null 2>&1 || true
fi

# Remove only certificates indexed as installed by Themisto. This avoids
# touching unrelated enterprise trust roots.
CERT_INDEX_DIR="/Library/Application Support/Themisto/certs"
if [ -d "$CERT_INDEX_DIR" ]; then
  echo "  Removing Themisto certificate trust..."
  for index in "$CERT_INDEX_DIR"/*.fingerprint; do
    [ -f "$index" ] || continue
    fingerprint="$(sed -n 's/.*"fingerprint":"\([0-9a-fA-F]*\)".*/\1/p' "$index")"
    if [ -z "$fingerprint" ]; then
      fingerprint="$(tr -d '[:space:]' < "$index")"
    fi
    case "$fingerprint" in
      *[!0-9a-fA-F]*|'') ;;
      *) /usr/bin/security delete-certificate -Z "$fingerprint" /Library/Keychains/System.keychain >/dev/null 2>&1 || true ;;
    esac
  done
fi

# ── Remove files ────────────────────────────────────────────────────────────

echo "  Removing application bundle..."
rm -rf /Applications/Themisto.app

echo "  Removing binaries..."
rm -f /usr/local/bin/themisto-agent
rm -f /usr/local/bin/themisto-service
rm -f /usr/local/bin/themisto-activate
rm -f /usr/local/bin/themisto-rollback
rm -f /usr/local/bin/themisto-uninstall
rm -rf /usr/local/share/themisto

echo "  Removing launchd plist..."
rm -f "$PLIST"

echo "  Removing configuration..."
rm -rf /etc/themisto

echo "  Removing logs..."
rm -rf /var/log/themisto

echo "  Removing proxy state..."
rm -rf "/Library/Application Support/Themisto"

echo "  Removing desktop startup entries..."
for user_home in /Users/*; do
  [ -d "$user_home" ] || continue
  rm -f "$user_home/Library/LaunchAgents/com.themisto.desktop.plist"
done

# ── Forget the package receipt ──────────────────────────────────────────────

pkgutil --forget com.themisto.desktop >/dev/null 2>&1 || true
pkgutil --forget com.themisto.agent   >/dev/null 2>&1 || true

echo "Themisto has been uninstalled."
