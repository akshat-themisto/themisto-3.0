{
  "manifest_version": 3,
  "name": "Themisto Prompt Capture (Chromium)",
  "version": "1.0.2",
  "description": "Pre-send prompt capture and enforcement for managed AI web apps.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:17175/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
