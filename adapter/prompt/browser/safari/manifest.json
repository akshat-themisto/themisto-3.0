{
  "manifest_version": 3,
  "name": "Themisto Prompt Capture (Safari)",
  "version": "1.0.1",
  "description": "Pre-send prompt capture and enforcement for managed AI web apps.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:17175/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://x.ai/*",
    "https://*.x.ai/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://x.ai/*",
        "https://*.x.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
